// 全局：I18n（翻译，纯函数字典）、Backend（命令通道）、Theme（主题配色）

export global I18n {
    in-out property <int> lang: 0;
    // 纯函数字典：lang 0=中文，1=English。纯函数可安全用于属性绑定。
    public pure function tr(key: string, lang: int) -> string {
        if key == "appTitle" { return lang == 1 ? "GMod Tools" : "GMod 工具箱"; }
        if key == "tabMain" { return lang == 1 ? "Pack & Upload" : "打包与上传"; }
        if key == "tabTools" { return lang == 1 ? "Other Tools" : "其他工具"; }
        if key == "tabAbout" { return lang == 1 ? "About" : "关于"; }
        if key == "cardPack" { return lang == 1 ? "Pack GMA" : "打包 GMA"; }
        if key == "btnCheck" { return lang == 1 ? "Integrity" : "完整性检查"; }
        if key == "btnPack" { return lang == 1 ? "Pack GMA" : "打包 GMA"; }
        if key == "lblSource" { return lang == 1 ? "Source folder" : "素材文件夹"; }
        if key == "phSource" { return lang == 1 ? "Select addon folder (addon.json auto-loaded)" : "选择 addon 文件夹（含 addon.json 将自动读取）"; }
        if key == "lblName" { return lang == 1 ? "Addon name" : "Addon 名称"; }
        if key == "phName" { return lang == 1 ? "addon title" : "addon 标题"; }
        if key == "lblType" { return lang == 1 ? "Addon type" : "Addon 类型"; }
        if key == "lblVer" { return lang == 1 ? "Addon version" : "Addon 版本"; }
        if key == "lblSteamId" { return lang == 1 ? "Author SteamID" : "作者 SteamID"; }
        if key == "phSteamId" { return lang == 1 ? "optional, 64-bit id" : "可选，64 位数字"; }
        if key == "lblTags" { return lang == 1 ? "Tags (comma)" : "标签（逗号）"; }
        if key == "phTags" { return lang == 1 ? "max 2, e.g. fun, roleplay" : "最多 2 个，如 fun, roleplay"; }
        if key == "lblIgnore" { return lang == 1 ? "Ignore patterns" : "忽略通配符"; }
        if key == "phIgnore" { return lang == 1 ? "e.g. *.psd, *.svn*, .git, *.tmp" : "如 *.psd, *.svn*, .git, *.tmp"; }
        if key == "lblDesc" { return lang == 1 ? "Description" : "描述"; }
        if key == "phDesc" { return lang == 1 ? "optional" : "可选"; }
