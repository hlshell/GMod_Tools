export global Backend {
    callback action(string);
}

// 主题配色：偏淡蓝渐变（由 dark 驱动）。hover 底色用淡蓝浅层，避免与背景相冲。
export global Theme {
    in-out property <bool> dark: false;
    // 基础背景（淡蓝灰调）
    in-out property <color> background: dark ? #14181e : #edf2f9;
    in-out property <color> window-background: dark ? #1b2129 : #fbfdff;
    in-out property <color> foreground: dark ? #e6eaf0 : #1c2733;
    in-out property <color> foreground-on-accent: dark ? #0e1319 : #ffffff;
    // 主色（淡蓝）
    in-out property <color> accent: dark ? #4f9bf7 : #2f7cec;
    // 主色渐变（按钮/高亮块）：hover 更亮
    in-out property <brush> accent-gradient: dark
        ? @linear-gradient(135deg, #5ea4f8 0%, #3b7cf0 100%)
        : @linear-gradient(135deg, #5ba0f5 0%, #2f7cec 100%);
    in-out property <brush> accent-gradient-hover: dark
        ? @linear-gradient(135deg, #6cb0fa 0%, #4889f4 100%)
        : @linear-gradient(135deg, #6fb0f8 0%, #4086ef 100%);
    // hover 底色（淡蓝浅层，通用：按钮/图标/抽屉片 hover）
    in-out property <color> hover: dark ? #26313f : #e1ebf9;
    in-out property <color> button-background: dark ? #232b34 : #eef2f8;
    in-out property <color> button-foreground: dark ? #e6eaf0 : #1c2733;
    in-out property <color> input-background: dark ? #1d242d : #f2f6fc;
    in-out property <color> input-foreground: dark ? #e6eaf0 : #1c2733;
    in-out property <color> outline: dark ? #323b47 : #d6e1ee;
    in-out property <color> neutral-foreground: dark ? #98a3b0 : #64748a;
}
